{
  "name": "nuxt-web-app-launch-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "pnpm install && pnpm setup:env && pnpm exec prisma generate",
    "setup:env": "dotenvx decrypt -f .env.example --stdout > .env",
    "env:sync": "node scripts/env-sync.mjs",
    "env:check": "node scripts/env-check.mjs",
    "build": "nuxt build",
    "dev": "NODE_OPTIONS=--max-old-space-size=8192 nuxt dev",
    "preview": "nuxt preview",
    "db:local": "node scripts/pglite.mjs server",
    "db:local:setup": "node scripts/pglite.mjs exec -- prisma migrate deploy && pnpm exec prisma generate && node scripts/pglite.mjs exec -- pnpm seed",
    "db:local:studio": "node scripts/pglite.mjs exec -- prisma studio",
    "dev:local": "NODE_OPTIONS=--max-old-space-size=8192 node scripts/pglite.mjs exec -- nuxt dev",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "lint": "node scripts/quiet.mjs lint eslint . --cache --cache-location node_modules/.cache/eslint",
    "lint:verbose": "eslint .",
    "check:changed": "node scripts/check.mjs",
    "typecheck": "node scripts/quiet.mjs typecheck pnpm run typecheck:all",
    "typecheck:verbose": "pnpm run typecheck:all",
    "test:unit": "node scripts/quiet.mjs test:unit vitest run",
    "test:unit:verbose": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "node scripts/quiet.mjs test:e2e playwright test",
    "test:e2e:verbose": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "shot": "node scripts/shot.mjs",
    "upload": "node scripts/upload.mjs",
    "og": "tsx scripts/og/render.ts",
    "seed": "pnpm tsx prisma/seed.ts",
    "seed:check": "tsx prisma/seed-integrity.ts",
    "storybook": "STORYBOOK_DISABLE_NUXT_FONTS=1 storybook dev -p 6006",
    "storybook:build": "STORYBOOK_DISABLE_NUXT_FONTS=1 storybook build",
    "typecheck:all": "nuxt typecheck && tsc --noEmit -p tsconfig.test.json"
  },
  "prisma": {
    "seed": "pnpm tsx prisma/seed.ts"
  },
  "dependencies": {
    "@clerk/nuxt": "^2.0.5",
    "@iconify-json/hugeicons": "^1.2.24",
    "@neondatabase/serverless": "1.0.2",
    "@nuxt/ui": "^4.5.1",
    "@prisma/adapter-neon": "^7.9.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "dotenv": "^17.2.3",
    "nuxt": "~4.4.8",
    "pg": "^8.22.0",
    "vue-router": "5.0.3"
  },
  "devDependencies": {
    "@clerk/testing": "^2.0.27",
    "@dotenvx/dotenvx": "^1.71.0",
    "@lhci/cli": "^0.15.1",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/schema": "~4.4.8",
    "@playwright/test": "^1.59.1",
    "@storybook-vue/nuxt": "9.0.1",
    "@storybook/addon-a11y": "^9.0.5",
    "@storybook/addon-docs": "^9.0.5",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.16.0",
    "@vercel/blob": "^2.8.0",
    "eslint": "^9.39.3",
    "eslint-plugin-better-tailwindcss": "^4.3.2",
    "eslint-plugin-storybook": "^9.0.5",
    "husky": "^9.1.7",
    "prisma": "^7.9.0",
    "storybook": "^9.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.6.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "@parcel/watcher",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "unrs-resolver",
      "vue-demi"
    ]
  }
}
