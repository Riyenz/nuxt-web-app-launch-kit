{
  // `nuxt typecheck` only covers app/, server/ and the Nuxt config — tests/ and the
  // test runner configs sit outside every project reference it generates, so without
  // this file a broken spec type would not surface until the suite ran.
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"],
      "@/*": ["./app/*"],
      "~~/*": ["./*"],
      "@@/*": ["./*"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
