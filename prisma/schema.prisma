// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int    @id @default(autoincrement())
  email String @unique
  name  String?
  posts Post[]
}

model Post {
  id        Int     @id @default(autoincrement())
  title     String
  content   String?
  published Boolean @default(false)
  authorId  Int
  author    User    @relation(fields: [authorId], references: [id])
}

// One row per failed attempt, keyed "<scope>:<key>" by server/utils/rate-limit.ts. Kept in
// Postgres so the limit holds across serverless instances and cold starts.
model RateLimitFailure {
  id       String   @id @default(cuid())
  key      String
  failedAt DateTime @default(now())

  @@index([key, failedAt])
}
