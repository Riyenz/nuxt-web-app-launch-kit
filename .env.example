DATABASE_URL=

NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NUXT_CLERK_SECRET_KEY=

# Neon (Conductor workspace automation)
NEON_PROJECT_ID=
NEON_API_KEY=
NEON_PARENT_BRANCH=development

# CI/CD database migration targets
DEV_DATABASE_URL=
PROD_DATABASE_URL=

# Optional — pnpm upload (public links for phone review)
BLOB_READ_WRITE_TOKEN=

# Optional — raise the DB connection pool. Left unset, app/lib/db-adapter.ts uses a
# single connection for any non-Neon URL, which is required for the local PGlite server.
# CI sets this to 10 against a real Postgres.
DB_POOL_MAX=
