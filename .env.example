# Postgres connection string. Defaults to the local PGlite server started by
# `make db-local` — replace it only to point the app at Neon or another Postgres.
# Paseo worktrees have this rewritten automatically by .paseo/setup.sh.
DATABASE_URL=postgres://postgres:postgres@localhost:51314/template1?sslmode=disable
# Unpooled endpoint for Prisma Migrate; only needed with Neon's -pooler host.
DIRECT_URL=

NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NUXT_CLERK_SECRET_KEY=

# Neon. Local dev uses PGlite and needs none of these.
# The Vercel preview build reads NEON_PROJECT_ID, NEON_PREVIEW_API_KEY and
# NEON_PARENT_BRANCH. GitHub Actions uses NEON_PROJECT_ID and NEON_API_KEY
# only to delete a preview branch when a pull request closes.
NEON_PROJECT_ID=
NEON_API_KEY=
NEON_PREVIEW_API_KEY=
NEON_PARENT_BRANCH=development

# Optional. Product name in emails and the server's log service name. Left commented: an
# empty NUXT_PUBLIC_* line overrides the default in nuxt.config.ts with an empty string.
# NUXT_PUBLIC_APP_NAME=Launch Kit

# Optional. PostHog analytics, session replay, error tracking, server logs and feature
# flags. Set the key only in Vercel's production environment. Without it all of these are
# off and every flag is its default. See docs/analytics.md and docs/feature-flags.md.
NUXT_PUBLIC_POSTHOG_KEY=
# PostHog's own US host by default. For a reverse proxy, set the host to the proxy and the
# UI host to https://us.posthog.com (or https://eu.posthog.com).
# NUXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# NUXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
# Forces flags without PostHog: `new-billing,old-banner=false`.
NUXT_PUBLIC_FEATURE_FLAGS=

# Optional. Resend transactional email, sent only from a production build whose public
# URL is set and is not localhost. The sender must be on a domain Resend has verified.
# See docs/email.md.
NUXT_RESEND_API_KEY=
NUXT_RESEND_FROM_ADDRESS=
NUXT_APP_URL=

# Optional — pnpm upload (public links for phone review)
BLOB_READ_WRITE_TOKEN=

# Optional — raise the DB connection pool. Left unset, app/lib/db-adapter.ts uses a
# single connection for any non-Neon URL, which is required for the local PGlite server.
# CI sets this to 10 against a real Postgres.
DB_POOL_MAX=
